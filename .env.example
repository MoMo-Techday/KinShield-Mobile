# Endpoints công khai dùng khi chạy app trên thiết bị thật.
EXPO_PUBLIC_API_URL=https://api-core.kinshield.click/api
EXPO_PUBLIC_WS_URL=https://api-core.kinshield.click

# Android Emulator có thể dùng http://10.0.2.2:4000 cho Core trên host, thêm /api cho REST.
# Expo Web cần thêm origin của Metro, thường là http://localhost:8081, vào CORS_ORIGIN của Core.
