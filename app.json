{
  "expo": {
    "name": "kinshield-mobile",
    "slug": "kinshield-mobile",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kinshieldmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "click.kinshield.mobile.preview",
      "permissions": ["android.permission.READ_PHONE_STATE"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "KinShield cần quyền micro để nhận dạng lời nói khi bạn chủ động bật bảo vệ cuộc gọi. Âm thanh có thể được dịch vụ nhận dạng của thiết bị xử lý; KinShield chỉ nhận văn bản đã che thông tin nhạy cảm.",
          "speechRecognitionPermission": "Cho phép KinShield sử dụng nhận dạng giọng nói khi bạn chủ động bật theo dõi cuộc gọi.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f6885f1e-a54e-4075-84e8-f05842fdbbeb"
      }
    },
    "owner": "momo-techday"
  }
}
