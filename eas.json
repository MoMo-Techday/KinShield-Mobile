{
    "cli": {
        "appVersionSource": "local"
    },
    "build": {
        "preview": {
            "distribution": "internal",
            "environment": "preview",
            "android": {
                "buildType": "apk",
                "credentialsSource": "remote",
                "env": {
                    "EXPO_PUBLIC_API_URL": "https://api-core.kinshield.click/api",
                    "EXPO_PUBLIC_WS_URL": "https://api-core.kinshield.click"
                }
            }
        }
    }
}
